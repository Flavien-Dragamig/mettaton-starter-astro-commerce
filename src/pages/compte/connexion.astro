---
// Page formulaire de connexion : HTML statique + fetch client vers l'API.
// Aucun appel réseau ni lecture de cookie au build → sûre dans les deux modes.
export const prerender = true;
---
<html lang="fr">
	<head><meta charset="utf-8" /><title>Connexion</title></head>
	<body>
		<h1>Connexion</h1>
		<form id="form-connexion">
			<input name="email" type="email" placeholder="Email" required />
			<input name="password" type="password" placeholder="Mot de passe" required />
			<button type="submit">Se connecter</button>
		</form>
		<script>
			document.getElementById('form-connexion')!.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = e.target as HTMLFormElement;
				const data = Object.fromEntries(new FormData(form));
				const res = await fetch('/api/compte/connexion', { method: 'POST', body: JSON.stringify(data) });
				if (res.ok) window.location.href = '/compte';
			});
		</script>
	</body>
</html>
