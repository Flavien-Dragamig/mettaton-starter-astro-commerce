# ─────────────────────────────────────────────────────────────────────────────
# Backend Medusa v2 — contrat d'environnement (Mettaton Palier 2)
# Variables injectées par le portail via application.saveEnvironment (Dokploy),
# JAMAIS committées ici avec des valeurs réelles. Noms figés côté portail
# (src/lib/medusa-provision.ts:buildMedusaEnv) — ne pas renommer sans y répercuter.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=
REDIS_URL=
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# Providers de paiement (optionnels au démarrage — activés par client dans
# l'Admin Medusa une fois le backend actif).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPLUG_SECRET_KEY=
